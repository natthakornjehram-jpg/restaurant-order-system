# โฟลเดอร์นี้มีแต่ไฟล์ที่ต้องถูก include จากสคริปต์อื่นเท่านั้น (ค่า DB, คีย์อีเมล ฯลฯ)
# ไม่มีไฟล์ไหนควรถูกเรียกตรงๆ ผ่าน URL เลย กันไว้อีกชั้นเผื่อ hosting ตั้งค่า PHP handler ผิดพลาด
# รองรับทั้ง Apache 2.4+ (mod_authz_core) และ Apache 2.2 รุ่นเก่า (mod_access_compat)
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
